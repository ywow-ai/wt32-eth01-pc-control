# Copy to .env and fill in. Never commit .env.
# PC scripts only — firmware reads NVS (apply with ./apply_env.sh).

# --- WT32 serial (apply_env.sh) ---
WT32_SERIAL_PORT="/dev/ttyUSB0"

# --- Jaringan WT32 ---
# auto | ethernet | wifi — production Wi‑Fi: wifi (skip ETH jika PHY mati)
NET_LINK="wifi"
WLAN_SSID=""
WLAN_PASS=""
# --- Performance (apply_env → NVS) ---
CPU_MHZ="160"
LOOP_DELAY_MS="5"
# ip_mode: dhcp | static (kosongkan ip_* jika dhcp)
IP_MODE="dhcp"
IP_ADDR=""
SUBNET=""
GATEWAY=""
DNS1=""
DNS2=""

# --- Pusher (push_pusher.sh + NVS ws/pusher_*) ---
APP_ID=""
KEY=""
SECRET=""
CLUSTER="ap1"
PUSHER_WS_HOST="ws-ap1.pusher.com"
PUSHER_CHANNEL="my-channel"
PUSHER_WS_PORT="443"

# --- Discord (opsional; URL dibangun dari ID+TOKEN) ---
DISCORD_WEBHOOK_ID=""
DISCORD_TOKEN=""
DISCORD_USER=""
DISCORD_EVENTS="power,reset"
