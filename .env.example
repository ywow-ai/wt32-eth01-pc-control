# Copy to .env and fill in. Never commit .env.
# PC scripts only — firmware reads NVS (apply with ./apply_env.sh).

# --- WT32 serial (apply_env.sh) ---
WT32_SERIAL_PORT="/dev/ttyUSB0"

# --- Jaringan WT32 ---
# auto | ethernet | wifi — LAN direct: ethernet + static di bawah
NET_LINK="ethernet"
WLAN_SSID=""
WLAN_PASS=""
# --- Performance (apply_env → NVS) ---
CPU_MHZ="160"
LOOP_DELAY_MS="5"
# ip_mode: dhcp | static (laptop eth 192.168.1.100/24 → WT32 contoh .201)
IP_MODE="static"
IP_ADDR="192.168.1.201"
SUBNET="255.255.255.0"
GATEWAY="192.168.1.1"
DNS1="192.168.1.1"
DNS2=""

# --- Pusher (push_pusher.sh + NVS ws/pusher_*) ---
APP_ID=""
KEY=""
SECRET=""
CLUSTER="ap1"
PUSHER_WS_HOST="ws-ap1.pusher.com"
PUSHER_CHANNEL="my-channel"
PUSHER_WS_PORT="443"

# --- Discord (opsional; URL dibangun dari ID+TOKEN) ---
DISCORD_WEBHOOK_ID=""
DISCORD_TOKEN=""
DISCORD_USER=""
DISCORD_EVENTS="power,reset"
